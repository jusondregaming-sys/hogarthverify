# Copy this file to .env for local dev, and set the same values as
# Environment Variables in your Vercel project settings for production.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN/api/discord/callback

# Any long random string — used to sign session cookies.
# Generate one with: openssl rand -hex 32
HOGARTH_SESSION_SECRET=

# Your site's base URL, no trailing slash (used to build redirects).
SITE_URL=https://YOUR-DOMAIN
